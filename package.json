{
	"name": "rune-form-monorepo",
	"private": true,
	"version": "0.0.0",
	"description": "Monorepo for rune-form library and demo apps",
	"scripts": {
		"dev": "pnpm --filter web dev",
		"build": "pnpm --filter web build",
		"preview": "pnpm --filter web preview",
		"check": "pnpm --filter web check",
		"format": "prettier --write .",
		"lint": "pnpm --filter web lint",
		"test": "pnpm --filter web test",
		"test:e2e": "pnpm --filter web test:e2e",
		"package:check": "pnpm --filter rune-form check",
		"package:test": "pnpm --filter rune-form test:unit",
		"package:publish": "pnpm --filter rune-form publish:build"
	},
	"type": "module",
	"devDependencies": {
		"prettier": "^3.7.3"
	},
	"engines": {
		"node": ">=24"
	}
}

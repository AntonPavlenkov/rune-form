{
	"name": "rune-form",
	"version": "0.1.5",
	"description": "Type-safe reactive form builder for Svelte 5",
	"type": "module",
	"svelte": "./src/lib/index.ts",
	"types": "./src/lib/index.ts",
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts"
		},
		"./zodAdapter": {
			"types": "./src/lib/zodAdapter.ts",
			"svelte": "./src/lib/zodAdapter.ts"
		},
		"./valibotAdapter": {
			"types": "./src/lib/valibotAdapter.ts",
			"svelte": "./src/lib/valibotAdapter.ts"
		}
	},
	"files": [
		"src/lib",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.spec.*"
	],
	"scripts": {
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "vitest",
		"publish:build": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "pnpm run publish:build"
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"valibot": "^1.0.0",
		"zod": "^3.0.0 || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		},
		"valibot": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.49.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.2.9",
		"fast-check": "^4.3.0",
		"jsdom": "^26.1.0",
		"publint": "^0.3.15",
		"svelte": "^5.45.2",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"valibot": "^1.2.0",
		"vite": "^7.2.4",
		"vitest": "^3.2.4",
		"zod": "^4.1.13"
	},
	"keywords": [
		"svelte",
		"rune",
		"form",
		"validation",
		"zod",
		"valibot",
		"runes",
		"reactive",
		"type-safe",
		"sveltekit"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AntonPavlenkov/rune-form.git"
	},
	"bugs": {
		"url": "https://github.com/AntonPavlenkov/rune-form/issues"
	},
	"homepage": "https://github.com/AntonPavlenkov/rune-form#readme",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	}
}
